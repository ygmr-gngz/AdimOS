{
  "name": "@adimos/remotion",
  "version": "0.1.0",
  "private": true,
  "description": "AdimOS video üretim motoru — Remotion tabanlı",
  "scripts": {
    "copy-fonts": "node scripts/copy-fonts.mjs",
    "sync:content-types": "tsx scripts/sync-content-types.ts",
    "check:content-types": "tsx scripts/sync-content-types.ts --check",
    "prebuild": "node scripts/copy-fonts.mjs && npx tsx scripts/emit-manifest.ts",
    "studio": "npx remotion studio src/index.ts",
    "render:quiz": "npx remotion render src/index.ts QuizVideo out/quiz.mp4",
    "build": "npx tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "deploy:site": "npm run prebuild && tsx scripts/deploy-site.ts",
    "sites:create": "npm run prebuild && npx remotion lambda sites create --site-name=adimos-remotion --region=eu-central-1 src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@fontsource/noto-sans": "5.1.1",
    "@remotion/bundler": "4.0.488",
    "@remotion/lambda": "4.0.488",
    "@remotion/renderer": "4.0.488",
    "@supabase/supabase-js": "^2.39.0",
    "@types/katex": "^0.16.8",
    "express": "^4.22.2",
    "katex": "0.16.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.488",
    "tsx": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.5.13",
    "typescript": "5.9.3"
  }
}
